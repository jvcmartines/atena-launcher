# Proxy reverso do nginx para o painel/API do Atena Launcher.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/atena-launcher
#   sudo ln -s /etc/nginx/sites-available/atena-launcher /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d launcher.seudominio.com.br
#
# O certbot reescreve este arquivo para adicionar o HTTPS. Depois de rodar ele,
# coloque ATENA_SECURE_COOKIES=true e ATENA_TRUST_PROXY=true no server/.env.

server {
    listen 80;
    listen [::]:80;
    server_name launcher.seudominio.com.br;

    # O painel aceita upload do modpack inteiro de uma vez.
    # Deixe esse valor maior que o maior .zip que a staff vai mandar.
    client_max_body_size 8G;

    # Upload de vários GB leva tempo; sem isso o nginx corta no meio.
    client_body_timeout     600s;
    proxy_read_timeout      600s;
    proxy_send_timeout      600s;
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Os arquivos do modpack são estáticos e podem ser bem grandes.
    # Servir direto pelo nginx tira essa carga do Node.
    #
    # ATENÇÃO: se você descomentar isto, o /files/ deixa de passar pelo Node —
    # e é o Node que confere quem pode baixar. Sem o secure_link abaixo, o
    # modpack fica aberto para qualquer um que saiba um caminho, mesmo com o
    # acesso restrito por cargo no painel.
    #
    # O segredo é o conteúdo de server/data/files.key. Copie-o para dentro das
    # aspas do secure_link_md5 (ou guarde num snippet fora do controle de
    # versão, que é o mais seguro):
    #
    #     sudo mkdir -p /etc/nginx/snippets
    #     printf 'secure_link_md5 "$secure_link_expires$uri %s";\n' \
    #         "$(cat /opt/atena-launcher/server/data/files.key)" \
    #         | sudo tee /etc/nginx/snippets/atena-files-secret.conf > /dev/null
    #     sudo chmod 640 /etc/nginx/snippets/atena-files-secret.conf
    #
    # Precisa do nginx compilado com --with-http_secure_link_module (o pacote
    # do Debian/Ubuntu já vem com ele). Confira com: nginx -V 2>&1 | grep secure_link
    #
    # location /files/ {
    #     secure_link $arg_md5,$arg_expires;
    #     include /etc/nginx/snippets/atena-files-secret.conf;
    #
    #     # "" = assinatura inválida ou ausente; "0" = assinatura boa, prazo vencido.
    #     if ($secure_link = "") { return 403; }
    #     if ($secure_link = "0") { return 410; }
    #
    #     alias /opt/atena-launcher/server/files/;
    #     add_header Cache-Control "private, max-age=300";
    #     sendfile on;
    #     tcp_nopush on;
    # }
}
