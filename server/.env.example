# Copie este arquivo para .env e ajuste os valores.
# cp .env.example .env

# Porta e interface em que o servidor escuta.
ATENA_PORT=3000
ATENA_HOST=0.0.0.0

# URL pública COMPLETA por onde os jogadores acessam este servidor.
# Ela entra nos links de download do modpack, então precisa estar correta.
# Sem barra no final.
ATENA_PUBLIC_URL=https://launcher.seudominio.com.br

# Segredo que assina os cookies de login do painel.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se deixar em branco, o servidor gera e guarda em data/session.key.
ATENA_SESSION_SECRET=

# Quantas horas o login da staff dura.
ATENA_SESSION_TTL_HOURS=12

# true quando o painel roda atrás de HTTPS (nginx com certificado).
ATENA_SECURE_COOKIES=true

# true quando há um proxy reverso na frente (nginx), para o IP real
# aparecer no limite de tentativas de login.
ATENA_TRUST_PROXY=true

# Tamanho máximo de cada arquivo enviado pelo painel, em MB.
ATENA_MAX_UPLOAD_MB=4096

# Onde ficam os dados. Caminhos relativos partem da pasta server/.
# Aponte ATENA_FILES_DIR para um disco com espaço sobrando se o modpack for grande.
ATENA_DATA_DIR=data
ATENA_FILES_DIR=files
ATENA_TMP_DIR=tmp

# true imprime cada requisição no log. Bom para diagnosticar
# se o launcher está conseguindo falar com o servidor.
ATENA_LOG_REQUESTS=false
