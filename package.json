{
    "name": "atena-launcher",
    "preductname": "Atena Launcher",
    "productName": "Atena Launcher",
    "version": "1.8.3",
    "description": "Launcher oficial do servidor Atena - Minecraft Forge 1.20.1",
    "main": "src/app.js",
    "author": {
        "name": "Atena",
        "email": "contato@atena.com.br",
        "url": "https://github.com/jvcmartines"
    },
    "url": "https://launcher.atenasmp.com/api",
    "scripts": {
        "start": "cross-env-shell NODE_ENV=dev electron .",
        "dev": "cross-env-shell DEV_TOOL=open nodemon --exec npm start",
        "build": "node build.js --obf=true --build=platform",
        "build:debug": "node build.js --obf=false --build=platform",
        "icon": "node build.js --icon",
        "server": "npm --prefix server start",
        "server:install": "npm --prefix server install",
        "build:local": "node build.js --obf=false --publish=never --build=platform",
        "build:ci": "node build.js --obf=true --publish=always --build=platform",
        "conferir": "node scripts/conferir-variaveis.js && node scripts/conferir-metodos.js && node scripts/conferir-seletores.js"
    },
    "license": "CCANC",
    "nodemonConfig": {
        "ext": "js,html,css",
        "ignore": [
            "**/test",
            "server/**"
        ]
    },
    "dependencies": {
        "electron-store": "^8.2.0",
        "electron-updater": "^6.7.3",
        "minecraft-java-core": "^4.2.5",
        "node-fetch": "^2.7.0",
        "xml-js": "^1.6.11"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "electron": "^40.0.0",
        "electron-builder": "^26.0.12",
        "javascript-obfuscator": "^5.1.0",
        "jimp": "^1.6.0",
        "nodemon": "^3.1.11",
        "png2icons": "^2.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jvcmartines/atena-launcher.git"
    }
}
